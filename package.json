{
  "name": "playwright-bdd-director",
  "version": "0.4.0",
  "description": "Write the Script, We'll Play the Show",
  "scripts": {
    "stage": "tsx scripts/md-ts-director.ts",
    "dress": "tsx scripts/dress-rehearsal.ts",
    "play": "npm run dress && tsx scripts/play.ts",
    "coldplay": "tsx scripts/play.ts",
    "show": "playwright test --ui",
    "review": "npx monocart show-report test-results/monocart-report/index.html",
    "autogen": "tsx scripts/auto-skeletons.ts",
    "matrix": "tsx scripts/coverage-matrix.ts",
    "ci": "tsx scripts/ci.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write . --log-level silent",
    "format:tests": "prettier --write test-suites tests --log-level silent",
    "lint": "eslint .",
    "lint:tests": "eslint tests",
    "lint:fix": "eslint --fix .",
    "lint:fix:tests": "eslint --fix tests",
    "postinstall": "node scripts/patch-playwright.js && node scripts/ensure-skills-link.js --soft",
    "build": "cd packages/director && npm run build && cd ../trace-viewer && npm run build && cd ../.. && npm run postinstall"
  },
  "keywords": [
    "playwright",
    "testing",
    "markdown",
    "test-cases",
    "automation",
    "manual-testing",
    "cyborg-testing"
  ],
  "author": "Andrii Pohanovskyi <poganovsky@gmail.com> (CyborgTests)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyborgTests/playwright-bdd-director"
  },
  "homepage": "https://github.com/CyborgTests/playwright-bdd-director#readme",
  "bugs": {
    "url": "https://github.com/CyborgTests/playwright-bdd-director/issues"
  },
  "devDependencies": {
    "@cucumber/cucumber-expressions": "^20.1.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/html-formatter": "^24.2.0",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "@cyborgtests/test": "^0.3.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "1.60.0",
    "@types/codemirror": "^5.60.18",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "minimatch": "^9.0.9",
    "monocart-reporter": "^2.11.1",
    "prettier": "^3.8.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
