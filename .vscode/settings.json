{
  // Director-style specs have no step definitions: open them with the "feature" language
  // so the official Cucumber extension does not report "Undefined step".
  // Step definitions style specs (CONFIG.bdd.dirs) stay "cucumber" - there the warning helps.
  "files.associations": {
    "**/test-suites/**/*.feature": "feature",
    "**/test-suites/bdd/**/*.feature": "cucumber"
  },
  "cucumber.features": ["test-suites/bdd/**/*.feature"],
  "cucumber.glue": ["src/steps/**/*.steps.ts"]
}
