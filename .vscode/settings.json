{
  // Every Gherkin spec is automated by step definitions: the official Cucumber extension links
  // steps to their definitions (go to definition, autocomplete, "Undefined step" warnings).
  // Page Objects hold steps decorated with @Given / @When / @Then.
  "files.associations": {
    "**/test-suites/**/*.feature": "cucumber"
  },
  "cucumber.features": ["test-suites/**/*.feature"],
  "cucumber.glue": ["src/steps/**/*.steps.ts", "src/pages/**/*.ts"]
}
