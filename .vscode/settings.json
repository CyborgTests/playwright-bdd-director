{
  // Specs are automated by step definitions: for Gherkin specs the official Cucumber extension
  // links steps to their definitions (go to definition, autocomplete); an "Undefined step" is
  // a step a person walks. Page Objects of migrated suites hold decorated steps.
  "files.associations": {
    "**/test-suites/**/*.feature": "cucumber"
  },
  "cucumber.features": ["test-suites/**/*.feature"],
  "cucumber.glue": ["src/steps/**/*.steps.ts", "src/pages/**/*.ts"]
}
